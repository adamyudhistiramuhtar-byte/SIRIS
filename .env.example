# Template perencanaan saja; belum dibaca aplikasi apa pun.
# Salin ke .env lokal setelah arsitektur/runtime disepakati. Jangan commit nilainya.
NODE_ENV=development
PORT=
DATABASE_URL=
# Role migrasi (DDL) terpisah dari role runtime non-superuser pada DATABASE_URL (SRS-44).
DATABASE_MIGRATION_URL=
# Hanya digunakan bila pilihan autentikasi session disetujui (OD-07).
SESSION_SECRET=
PRIVATE_STORAGE_ROOT=
ALLOWED_ORIGIN=
# Zona sumber operasional belum diputuskan; zona jadwal proyek Asia/Jakarta.
APP_TIMEZONE=
VITE_API_BASE_URL=/api/v1
LOG_LEVEL=
