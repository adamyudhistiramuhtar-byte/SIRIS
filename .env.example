# Template konfigurasi lokal. Backend membaca berkas .env melalui dotenv.
# Salin ke .env lokal lalu isi sesuai lingkungan. Jangan commit nilai .env.
# Nilai kosong diperlakukan sebagai "tidak diisi" sehingga default aman berlaku.
NODE_ENV=development
PORT=
DATABASE_URL=
# Hanya digunakan bila pilihan autentikasi session disetujui (OD-07).
SESSION_SECRET=
PRIVATE_STORAGE_ROOT=
ALLOWED_ORIGIN=
# Zona sumber operasional belum diputuskan; zona jadwal proyek Asia/Jakarta.
APP_TIMEZONE=
API_PREFIX=
VITE_API_BASE_URL=/api/v1
LOG_LEVEL=
