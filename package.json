{
  "name": "siris",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@siris/web",
    "dev:all": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev --workspace=@siris/web",
    "dev:api": "npm run dev --workspace=@siris/api",
    "build": "npm run build:contracts && npm run build:api && npm run build:web",
    "build:contracts": "npm run build --workspace=@siris/contracts",
    "build:web": "npm run build --workspace=@siris/web",
    "build:api": "npm run build --workspace=@siris/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "test:unit": "vitest run apps/",
    "test:integration": "vitest run tests/integration/",
    "check:repo": "python3 scripts/check_repository.py --tracked",
    "tokens:generate": "node scripts/generate-design-tokens.mjs",
    "tokens:check": "node scripts/generate-design-tokens.mjs --check",
    "test:evidence": "node scripts/run-uji-tests.mjs",
    "test:e2e": "npm run build:contracts && npm run build:api && node scripts/run-uji-e2e.mjs",
    "test:db:up": "node scripts/uji-db.mjs up",
    "test:db:down": "node scripts/uji-db.mjs down",
    "typecheck:harness": "tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "1.65.1",
    "eslint": "^9.20.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
